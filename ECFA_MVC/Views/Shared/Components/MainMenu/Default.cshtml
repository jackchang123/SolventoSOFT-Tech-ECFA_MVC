@model List<ECFA_MVC.ViewModels.MenuViewModel>

<div class="wrap">
    <nav class="main-nav" aria-label="主選單">
        <ul id="main-menu" class="sf-menu">
            @foreach (var item in Model)
            {
                var hasSubMenu = item.SubMenus != null && item.SubMenus.Any();

                <li>
                    <a href="@item.Url"
                       role="@(hasSubMenu ? "button" : null)"
                       title="@item.Title"
                       aria-haspopup="@(hasSubMenu ? "true" : "false")"
                       aria-expanded="false">
                        @item.Title
                    </a>

                    @if (hasSubMenu)
                    {
                        <ul>
                            @foreach (var subItem in item.SubMenus!)
                            {
                                var l2HasSub = subItem.SubMenus != null && subItem.SubMenus.Any();
                                <li>
                                    <a class="@(l2HasSub ? "sf-with-ul" : null)" href="@subItem.Url" title="@subItem.Title">
                                        @subItem.Title 
                                        @if (l2HasSub)
                                        {
                                            <span class='submenu-arrow' aria-hidden='true'></span>
                                        }
                                    </a>
                                    @if (l2HasSub)
                                    {
                                        <ul>
                                            @foreach (var l3 in subItem.SubMenus!)
                                            {
                                                <li>
                                                    <a href="@l3.Url" target="@l3.Target" title="@l3.Title">
                                                        @l3.Title
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    </nav>
</div>