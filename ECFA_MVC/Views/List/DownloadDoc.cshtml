@{
    Layout = "~/Views/Shared/_LayoutList.cshtml";
    ViewData["Title"] = ViewBag.TitleName;
}

<!-- 標題列 -->
<div class="title-row">
    <h2>@ViewBag.TitleName</h2>
</div>

<!-- 資料列表表格 -->
<div class="table-container">
    <div class="table-container">
        <table class="list-table">
            <caption class="sr-only">認識ECFA歷史文件區下簡報相關檔案列表</caption>
            <thead>
                <tr>
                    <th scope="col">標題</th>
                </tr>
            </thead>
            <tbody id="data-table-body">

            </tbody>
        </table>
    </div>
</div>
<!-- 分頁容器（必須保留原 ID，供 main.js 偵測） -->
<div class="pagination-wrapper" role="navigation" aria-label="頁碼分頁">
    <ul id="pagination-container" class="pagination"></ul>
</div>

@section Styles {
    <script src="~/js/fileHelper.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // 網頁一載入，自動讀取第 1 頁
            loadPageData(1, true);
        });

        // 負責發送 Ajax 撈資料的統一函式
        function loadPageData(pageNumber, isFirstLoad) {
            const urlParams = new URLSearchParams(window.location.search);
            const currentCid = parseInt(urlParams.get('c'), 10);
            const categoryId = isNaN(currentCid) ? '' : currentCid;
            $.ajax({
                url: '@Url.Action("GetECFADocList", "ECFADoc")',
                data: { categoryId: categoryId, pageNumber: pageNumber, pageSize: 10 },
                type: 'GET',
                success: function(response) {
                    // 1. 渲染您的 Table 資料畫面
                    renderTable(response.items);

                    // 2. 如果是第一次載入，拿到真正的 totalCount 後，再去初始化分頁套件
                    if (isFirstLoad) {
                        initPaginationWithRealCount(response.totalCount);
                    }
                }
            });
        }

        // 動態傳入實體總筆數，並初始化分頁
        function initPaginationWithRealCount(realTotalCount) {
            const $container = $("#pagination-container");
            const itemsOnPage = 10;
            const maxPageVisibleItems = $(window).width() >= 992 ? 10 : 6;

            // 清空舊的分頁 UI（避免重複初始化產生衝突）
            $container.empty();

            // 實例化套件
            const pagination = new Pagination({
                container: $container,
                maxVisibleElements: maxPageVisibleItems,
                showInput: false,
                enhancedMode: false,
                pageClickCallback: function(pageNumber) {
                    // 點擊非第一頁的頁碼時，只撈資料，不需要重複初始化分頁
                    loadPageData(pageNumber, false);
                    sessionStorage.setItem("faq_current_page", pageNumber);
                    // 執行您原本在 Main.js 裡的 UI 優化邏輯...
                    if (typeof updateAriaCurrent === 'function') {
                        updateAriaCurrent(pageNumber);
                    }
                }
            });

            // 完美注入後端傳來的實體總筆數！
            pagination.make(realTotalCount, itemsOnPage);
        }

        // 渲染 Table 的實作（請依您的欄位名稱調整）
        function renderTable(dataList) {
            const $tbody = $("#data-table-body");
            $tbody.empty(); // 先清空舊資料

            $.each(dataList, function(index, item) {
                const fileParams = new URLSearchParams();
                fileParams.set('Id', item.ntId || '');
                fileParams.set('T', 'ECFADoc');
                const fileLink = `/api/download?${fileParams.toString()}`

                // 1. 建立結構骨架，變數留空
                const $tr = $(`
                        <tr>
                            <td class="text-left">
                                <a href="#" class="link" title="">
                                    <span class="ellipsis"></span>
                                    <img src="../images/icon_pdf_red.svg" alt="" class="icon">
                                </a>
                            </td>
                        </tr>
                    `);

                $tr.find('a').attr('href', fileLink);     // 安全注入 href 屬性
                $tr.find('a').attr('title', item.ntFileName); // 安全注入 title 屬性
                $tr.find('.ellipsis').text(item.ntTitle);  // 安全注入文字

                const imgSrc = window.FileHelper.getFileIconSrc(item.ntFileName);
                $tr.find('.icon').attr('src', imgSrc);
                // 3. 將安全的元素塞入 tbody
                $tbody.append($tr);
            });
        }
    </script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    
}