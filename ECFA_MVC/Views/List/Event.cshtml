@{
    Layout = "~/Views/Shared/_LayoutList.cshtml";
    ViewData["Title"] = ViewBag.TitleName;
}

<!-- 標題列 -->
<div class="title-row">
    <h2>@ViewBag.TitleName</h2>
</div>

<!-- 資料列表表格 -->
<div class="table-container">
    <table class="list-table">
        <caption class="sr-only">認識ECFA歷史文件區下大事紀重要事件列表</caption>
        <thead>
            <tr>
                <th scope="col" class="col-fixed">日期</th>
                <th scope="col">重要事件</th>
            </tr>
        </thead>

        <tbody id="data-table-body">
            <!-- 資料會由 AJAX 動態渲染至此 -->
        </tbody>
    </table>
</div>
<!-- 分頁容器（必須保留原 ID，供 main.js 偵測） -->
<div class="pagination-wrapper" role="navigation" aria-label="頁碼分頁">
    <ul id="pagination-container" class="pagination"></ul>
</div>



@section Styles {
    <script>
        $(document).ready(function () {
            // 網頁一載入，自動讀取第 1 頁
            loadPageData(1, true);
        });

        // 負責發送 Ajax 撈資料的統一函式
        function loadPageData(pageNumber, isFirstLoad) {
            $.ajax({
                url: '@Url.Action("GetPagedList", "Event")',
                data: { pageNumber: pageNumber, pageSize: 10 },
                type: 'GET',
                success: function (response) {
                    // 1. 渲染您的 Table 資料畫面
                    renderTable(response.items);

                    // 2. 如果是第一次載入，拿到真正的 totalCount 後，再去初始化分頁套件
                    if (isFirstLoad) {
                        initPaginationWithRealCount(response.totalCount);
                    }
                }
            });
        }

        // 動態傳入實體總筆數，並初始化分頁
        function initPaginationWithRealCount(realTotalCount) {
            const $container = $("#pagination-container");
            const itemsOnPage = 10;
            const maxPageVisibleItems = $(window).width() >= 992 ? 10 : 6;

            // 清空舊的分頁 UI（避免重複初始化產生衝突）
            $container.empty();

            // 實例化套件
            const pagination = new Pagination({
                container: $container,
                maxVisibleElements: maxPageVisibleItems,
                showInput: false,
                enhancedMode: false,
                pageClickCallback: function (pageNumber) {
                    // 點擊非第一頁的頁碼時，只撈資料，不需要重複初始化分頁
                    loadPageData(pageNumber, false);

                    // 執行您原本在 Main.js 裡的 UI 優化邏輯...
                    if (typeof updateAriaCurrent === 'function') {
                        updateAriaCurrent(pageNumber);
                    }
                }
            });

            // 完美注入後端傳來的實體總筆數！
            pagination.make(realTotalCount, itemsOnPage);
        }

        function formatDate(dateStr) {
            if (!dateStr) return "-";
            const date = new Date(dateStr);

            const yyyy = date.getFullYear();
            const mm = String(date.getMonth() + 1).padStart(2, '0'); // 月份從 0 開始，需 +1
            const dd = String(date.getDate()).padStart(2, '0');

            return `${yyyy}/${mm}/${dd}`; // 產出如: 2026-07-30
        }

        // 渲染 Table 的實作（請依您的欄位名稱調整）
        function renderTable(dataList) {
            const $tbody = $("#data-table-body");
            $tbody.empty(); // 先清空舊資料

            $.each(dataList, function(index, item) {
                const formattedDate = formatDate(item.ntPubDate);
                // 1. 建立結構骨架，變數留空
                const $tr = $(`
                    <tr>
                        <th scope="row" class="text-left text-darkblue"></th>
                        <td class="text-left">
                            <p></p>
                        </td>
                    </tr>
                `);

                // 2. 使用安全無虞的 .text() 注入內容（弱掃必過）
                $tr.find('th').text(formattedDate);
                $tr.find('td p').text(item.ntContent);

                // 3. 將安全的元素塞入 tbody
                $tbody.append($tr);
            });
        }
    </script>
    <script src="~/js/main.js"></script>
}