@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "聯絡我們";
}
<!-- 主要內容區 -->
<main>
    <div class="wrap">
        <a href="#key_C" id="key_C" accesskey="C" title="Alt+C 主要內容區" class="visually-hidden">:::</a>

        <div class="main-wrap">
            <!-- 主要內容 -->
            <div class="main-content">
                <div class="content-header">
                    <!-- 麵包屑 -->
                    <div class="breadcrumb">
                        <img src="~/images/icon_breadcrumb.svg" alt="" class="icon">
                        <ul>
                            <li>聯絡我們</li>
                        </ul>
                    </div>

                    <!-- 社群列表 -->
                    @await Component.InvokeAsync("SocialMediaList")
                </div>
                <!-- 標題列 -->
                <div class="title-row">
                    <h2>聯絡我們</h2>
                </div>

                <div class="contact-info">
                    <p>免付費服務專線：<span class="text-bold">0800-002369（鈴鈴－我想瞭解）</span></p>
                    <p>專線電話：（02）2397-7590、2397-7591</p>
                    <p>傳真號碼：（02）23970522</p>
                    <p>E-mail：<a href="email:ECFA@trade.gov.tw">ECFA@trade.gov.tw</a></p>
                    <p>服務時間： 上午8:30 ~ 12:30、下午13:30 ~ 17:30</p>
                </div>
            </div>
        </div>
    </div>
</main>

@section Styles {
    <script src="~/js/main.js"></script>
    <link rel="stylesheet" href="~/css/style.css">
}